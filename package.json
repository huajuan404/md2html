{
  "name": "md2html",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Source-mapped Markdown projection editor that keeps Markdown editable and renders human-optimized HTML.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run src/",
    "test:shape": "vitest run src/tests/shape/",
    "test:invariant": "vitest run src/tests/invariant/",
    "test:visual": "playwright test --grep visual",
    "test:e2e": "playwright test --grep e2e",
    "test:all": "pnpm test:unit && pnpm test:visual && pnpm test:e2e",
    "dev:mock": "MD2HTML_LLM_PROVIDER=mock vite",
    "dev:claude": "MD2HTML_LLM_PROVIDER=claude vite",
    "dev:codex": "MD2HTML_LLM_PROVIDER=codex vite"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "latest",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "latest",
    "@codemirror/view": "latest",
    "@lezer/markdown": "latest",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "remark-gfm": "latest",
    "unified": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
